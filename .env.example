# Copy this file to .env and fill in your API key. Never commit .env itself.

# Model provider: "groq" (default), "vertexai"
# Groq is the default (free Llama 3 70B + FastEmbed local embeddings).
MODEL_PROVIDER=groq

# --- Groq (free tier) -------------------------------------------------------
# Get a free API key at https://console.groq.com/keys
GROQ_API_KEY=gsk_your-groq-key-here
GROQ_CHAT_MODEL=llama-3.3-70b-versatile
# Embeddings run locally via FastEmbed (ONNX, no API key needed).
# ~33MB model downloaded once on first run.
GROQ_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# --- GCP project (required for Vertex AI, and also for Firestore/Cloud
# Monitoring below regardless of MODEL_PROVIDER) -----------------------------
# Also run: gcloud auth application-default login
GCP_PROJECT_ID=
GCP_LOCATION=us-central1
VERTEX_CHAT_MODEL=gemini-2.0-flash-001
VERTEX_EMBEDDING_MODEL=text-embedding-005

# --- Shared settings --------------------------------------------------------
CHUNK_SIZE=800
CHUNK_OVERLAP=120
DOCS_DIR=docs
TOP_K=4

# --- Database (Cloud SQL + pgvector) ----------------------------------------
# Format: postgresql://user:password@host:port/dbname
# For Cloud SQL via Auth Proxy: postgresql://user:password@localhost:5432/ragdb
# For local Docker: postgresql://postgres:dev@localhost:5432/ragdb
DATABASE_URL=postgresql://postgres:dev@localhost:5432/ragdb
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10
EMBEDDING_DIMENSION=384

# --- Conversation memory (Firestore) -----------------------------------------
# Optional: with no GCP_PROJECT_ID and no FIRESTORE_EMULATOR_HOST, app/memory.py
# fails open (no conversation history) rather than erroring -- so this whole
# section can be left unset for local dev without Firestore at all.
FIRESTORE_COLLECTION=conversation_sessions
SESSION_TTL_HOURS=24
# For the local Docker emulator (see README "Local Firestore emulator"):
# FIRESTORE_EMULATOR_HOST=localhost:8080

# --- Metrics (OpenTelemetry) -------------------------------------------------
# GET /metrics (Prometheus format) always works with no config. Set true to
# also push to Cloud Monitoring (requires GCP_PROJECT_ID).
OTEL_GCP_EXPORT=false

# --- Async ingestion (Cloud Tasks) -------------------------------------------
# Unlike memory/metrics, Firestore is REQUIRED for /upload (job tracking is
# its contract, not an optimization) -- either FIRESTORE_EMULATOR_HOST above
# or GCP_PROJECT_ID must be set for uploads to work at all. The queue
# settings below are only used when GCP_PROJECT_ID is set; otherwise
# app/jobs.py runs the job in-process via FastAPI's BackgroundTasks instead
# of enqueueing a real Cloud Task (no official local Cloud Tasks emulator
# exists -- see README).
CLOUD_TASKS_QUEUE=ingest-queue
# Only needed in a real deployment -- the service's own public URL, which
# Cloud Tasks calls back into. Left blank for local dev.
INGEST_TARGET_URL=
JOB_TTL_HOURS=48

# --- LangSmith tracing (optional) -------------------------------------------
# Get a free API key at smith.langchain.com, then set LANGSMITH_TRACING=true
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=rag-capstone

# --- API Security (optional) -----------------------------------------------
# Set API_KEY to require X-API-Key header on all non-public endpoints.
# Leave empty to disable auth (good for local dev / demo).
API_KEY=
CORS_ORIGINS=*
RATE_LIMIT=20/minute
MAX_UPLOAD_SIZE_MB=50
MAX_QUESTION_LENGTH=2000

# --- LLM Resilience --------------------------------------------------------
LLM_MAX_RETRIES=3
LLM_REQUEST_TIMEOUT=60
