# Copy this file to .env and fill in your API key. Never commit .env itself.

# Model provider: "groq" (default), "vertexai"
# Groq is the default (free-tier chat + FastEmbed local embeddings).
MODEL_PROVIDER=groq

# --- Groq (free tier) -------------------------------------------------------
# Get a free API key at https://console.groq.com/keys
GROQ_API_KEY=gsk_your-groq-key-here
# Groq no longer serves any Llama chat model (the old llama-3.3-70b-versatile
# default 404s). gpt-oss-20b is Groq-hosted and live as of 2026-08.
GROQ_CHAT_MODEL=openai/gpt-oss-20b
# Embeddings run locally via FastEmbed (ONNX, no API key needed).
# ~33MB model downloaded once on first run.
GROQ_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# --- GCP project (required for Vertex AI, and also for Firestore/Cloud
# Monitoring below regardless of MODEL_PROVIDER) -----------------------------
# Also run: gcloud auth application-default login
GCP_PROJECT_ID=
GCP_LOCATION=us-central1
# flash-lite is ~3x cheaper on input / ~6x on output than gemini-2.5-flash
# and ~2x faster, which adds up: /ask makes three LLM calls per request.
VERTEX_CHAT_MODEL=gemini-2.5-flash-lite
VERTEX_EMBEDDING_MODEL=text-embedding-005

# --- Shared settings --------------------------------------------------------
CHUNK_SIZE=800
CHUNK_OVERLAP=120
DOCS_DIR=docs
TOP_K=4

# --- Database (Cloud SQL + pgvector) ----------------------------------------
# Format: postgresql://user:password@host:port/dbname
# For Cloud SQL via Auth Proxy: postgresql://user:password@localhost:5432/ragdb
# For local Docker: postgresql://postgres:dev@localhost:5432/ragdb
DATABASE_URL=postgresql://postgres:dev@localhost:5432/ragdb
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10
# Leave unset unless you're using a custom embedding model: app/config.py
# derives it from MODEL_PROVIDER (384 for groq/FastEmbed, 768 for Vertex
# AI's text-embedding-005). It fixes the VECTOR(N) column width when the
# schema is first created and pgvector rejects mismatched inserts, so
# switching provider needs the tables dropped and recreated, not just a
# re-ingest -- see README "Switching model providers".
# EMBEDDING_DIMENSION=768

# --- Conversation memory (Firestore) -----------------------------------------
# Optional: with no GCP_PROJECT_ID and no FIRESTORE_EMULATOR_HOST, app/retrieval/memory.py
# fails open (no conversation history) rather than erroring -- so this whole
# section can be left unset for local dev without Firestore at all.
FIRESTORE_COLLECTION=conversation_sessions
SESSION_TTL_HOURS=24
# For the local Docker emulator (see README "Local Firestore emulator"):
# FIRESTORE_EMULATOR_HOST=localhost:8080

# --- Metrics (OpenTelemetry) -------------------------------------------------
# GET /metrics (Prometheus format) always works with no config. Set true to
# also push to Cloud Monitoring (requires GCP_PROJECT_ID).
OTEL_GCP_EXPORT=false

# --- Async ingestion (Cloud Tasks) -------------------------------------------
# Unlike memory/metrics, Firestore is REQUIRED for /upload (job tracking is
# its contract, not an optimization) -- either FIRESTORE_EMULATOR_HOST above
# or GCP_PROJECT_ID must be set for uploads to work at all. The queue
# settings below are only used when GCP_PROJECT_ID is set; otherwise
# app/ingestion/jobs.py runs the job in-process via FastAPI's BackgroundTasks instead
# of enqueueing a real Cloud Task (no official local Cloud Tasks emulator
# exists -- see README).
CLOUD_TASKS_QUEUE=ingest-queue
# Only needed in a real deployment -- the service's own public URL, which
# Cloud Tasks calls back into. Left blank for local dev.
INGEST_TARGET_URL=
JOB_TTL_HOURS=48

# --- LangSmith tracing (optional) -------------------------------------------
# Get a free API key at smith.langchain.com, then set LANGSMITH_TRACING=true
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=rag-capstone

# --- Access tiers (app/api/middleware.py) ---------------------------------------
# API_KEY makes a WHOLE deployment private (staging uses this). Leave empty
# for the public demo -- the admin and internal tiers below stay enforced
# either way, so "public" no longer means "everything is open".
API_KEY=

# Gates /metrics only, via X-Admin-Key. Set this on any deployment reachable
# from the internet: /metrics exposes token counts, estimated spend, latency
# and error rates. Unset means /metrics returns 404 to everyone, which is the
# safe default -- absent config must not mean open.
ADMIN_KEY=

# Service account Cloud Tasks signs OIDC tokens as. When set,
# /internal/process-ingest-job accepts ONLY a valid token from this identity,
# making it unreachable from the public internet. Unset falls back to
# requiring API_KEY; with both unset the endpoint denies everything.
#
# The queue must be configured to match -- see README "Automated deploys".
TASKS_SERVICE_ACCOUNT_EMAIL=
CORS_ORIGINS=*
RATE_LIMIT=10/minute
MAX_UPLOAD_SIZE_MB=50

# --- Optional Firebase sign-in (app/api/auth.py) --------------------------------
# ADDITIVE, never a gate. Leave unset and the feature is inert: everyone is
# anonymous, the UI hides its sign-in button, and the public limits apply --
# which is the right shape for a public demo. Setting it up only ADDS the
# option to sign in for raised upload limits; it never blocks anyone.
#
# One-time setup: Firebase console -> add a Web App to this same GCP project
# -> enable the Google sign-in provider -> add your Cloud Run domain under
# Authentication > Settings > Authorized domains. Copy the web config below.
# The web API key is a public identifier, not a credential -- access is
# controlled by authorized domains and security rules, not by hiding it.
# FIREBASE_PROJECT_ID defaults to GCP_PROJECT_ID.
FIREBASE_PROJECT_ID=
FIREBASE_WEB_API_KEY=
FIREBASE_AUTH_DOMAIN=
# Ceilings for signed-in callers; anonymous visitors keep the values above.
MAX_UPLOAD_FILES_AUTHED=10
MAX_UPLOAD_SIZE_MB_AUTHED=10
MAX_QUESTION_LENGTH=2000

# --- Security hardening (app/api/security.py) -----------------------------------
# Prompt-injection screening. Regex-only, no tokens, no network. On by
# default: a refused request is rejected BEFORE retrieval, so screening
# makes an attack cheaper to handle, not dearer. Patterns favour precision
# over recall -- on a public demo, refusing a real question is worse than
# missing a borderline one.
ENABLE_INJECTION_SCREENING=true

# PII redaction of logged questions/answers via Cloud DLP. OFF by default.
#
# WARNING: this control fails CLOSED. If it is enabled but DLP is
# unreachable -- including the common case of the DLP API simply not being
# enabled on the project -- every logged question/answer becomes
# "[redaction unavailable]" rather than being written raw. That is the
# correct trade for a privacy control, but it means turning this on without
# first running:
#     gcloud services enable dlp.googleapis.com --project=YOUR_PROJECT_ID
# will silently cost you your request logs. Requires GCP_PROJECT_ID, and
# adds one DLP API call per /ask* request.
ENABLE_PII_REDACTION=false
# Comma-separated DLP infoTypes. PERSON_NAME/STREET_ADDRESS are deliberately
# excluded -- both fire constantly on ordinary product and company nouns in
# a support corpus, and a log that is mostly [PERSON_NAME] is unreadable.
DLP_INFO_TYPES=EMAIL_ADDRESS,PHONE_NUMBER,CREDIT_CARD_NUMBER,US_SOCIAL_SECURITY_NUMBER,IBAN_CODE,IP_ADDRESS

# --- LLM Resilience --------------------------------------------------------
LLM_MAX_RETRIES=3
LLM_REQUEST_TIMEOUT=60

# Circuit breaker (app/llm/circuit.py) -- always on. After this many CONSECUTIVE
# failed calls, the provider is skipped entirely for the cooldown instead of
# every request rediscovering the outage through the full retry/timeout
# sequence. Any success resets the count, so an isolated error inside healthy
# traffic can't trip it. Note each failure counted here is already
# LLM_MAX_RETRIES upstream attempts: 3 is roughly 9 real attempts.
LLM_CIRCUIT_FAILURE_THRESHOLD=3
LLM_CIRCUIT_COOLDOWN_SECONDS=30

# --- Cost controls ---------------------------------------------------------
# Fraction of answered requests that also run the groundedness check
# (0.0-1.0). 1.0 = every request, the default. The check is a whole extra LLM
# call over the same context, so 0.25 removes roughly a quarter of
# per-request spend at the cost of a per-answer verdict.
GROUNDEDNESS_SAMPLE_RATE=1.0
# Estimated LLM spend ceiling per UTC day, USD. 0 disables. Once reached,
# /ask* returns 503 with a friendly message instead of making paid calls.
# The figure is an estimate from app/llm/cost.py's price table, and the
# counter is per-process -- with maxScale=2 the real worst case is ~2x this.
DAILY_BUDGET_USD=0

# Automatic failover: which provider to route CHAT calls to while
# MODEL_PROVIDER's circuit is open. "groq", "vertexai", or empty to disable.
# Requires working credentials for that provider in this deployment --
# a fallback that can't authenticate is disabled with a warning at startup.
# Embeddings never fail over (the pgvector store is built in one provider's
# embedding space); see app/llm/providers.py.
LLM_FALLBACK_PROVIDER=
