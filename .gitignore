# Python environments
venv/
.venv/

# Python cache & artifacts
__pycache__/
*.pyc
*.pyo
*.egg-info/
dist/
build/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# Environment & secrets
.env
.env.*
!.env.example

# Working notes, design docs, scratch writing. Deliberately OUTSIDE docs/:
# app/ingest.py globs docs/ recursively, so anything left there becomes
# retrievable RAG content. docs/ is the sample corpus the demo answers
# from, not a place for project documentation.
notes/

# Same rule, different filenames. Both of these declare themselves
# deliberately untracked, but "untracked" is not a property a file keeps on
# its own -- a single `git add -A` commits them. The repository-voice rule in
# CLAUDE.md says demo scripts and session narratives must not reach the
# tracked repo, so it is enforced here rather than left to whoever types the
# next add.
DEMO.md
AUTOPLAN-REVIEW-*.md

# FastEmbed model cache (baked into the Docker image at build time instead --
# see Dockerfile; this is just the local dev equivalent)
.fastembed_cache/

# Logs & eval outputs
logs/
*.log
eval_results.json
ragas_results.json

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db
